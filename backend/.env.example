# ================================================
# MyTicketSA v7 Environment Variables
# Copy this file to .env and fill in your values
# ================================================

# ── Server ──────────────────────────────────────
PORT=5500
NODE_ENV=development

# ── Supabase ─────────────────────────────────────
# Find these in your Supabase project:
#   Settings → API → Project URL / anon key / service_role key
#   Settings → API → JWT Secret  (for SUPABASE_JWT_SECRET)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJh...
SUPABASE_SERVICE_ROLE_KEY=eyJh...
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ── Cloudinary (image & QR code storage) ─────────
# Find these in your Cloudinary dashboard → Settings → API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── CORS ──────────────────────────────────────────
# Comma-separated allowed origins, or * for all
FRONTEND_URL=*

# ── Email (Gmail SMTP) ───────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_gmail@gmail.com
# Use a Gmail App Password (not your real password):
# https://myaccount.google.com/apppasswords
EMAIL_PASS=your_16_char_app_password
EMAIL_FROM=MyTicketSA <your_gmail@gmail.com>
# true = log emails to console instead of sending (good for dev)
EMAIL_PREVIEW=true

# ── Storage ──────────────────────────────────────
# Where QR code PNGs are saved (relative to backend/)
TICKETS_DIR=./tickets
