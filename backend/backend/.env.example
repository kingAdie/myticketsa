# ================================================
# MyTicketSA v6 — Environment Variables
# Copy this file to .env and fill in your values
# ================================================

# ── Server ──────────────────────────────────────
PORT=5500
NODE_ENV=development   # change to 'production' when deploying

# ── MySQL Database ───────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=myticketsa

# ── JWT Secret ───────────────────────────────────
# Generate a strong secret:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX_STRING

# ── Email (Gmail SMTP) ───────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_gmail@gmail.com
# Use a Gmail App Password (not your real password):
# https://myaccount.google.com/apppasswords
EMAIL_PASS=your_16_char_app_password
EMAIL_FROM=MyTicketSA <your_gmail@gmail.com>
# true = log emails to console instead of sending (good for dev)
EMAIL_PREVIEW=true

# ── PayFast ──────────────────────────────────────
PAYFAST_MERCHANT_ID=10000100
PAYFAST_MERCHANT_KEY=46f0cd694581a
PAYFAST_PASSPHRASE=
# true = use PayFast sandbox (no real money)
PAYFAST_SANDBOX=true
PAYFAST_RETURN_URL=http://localhost:5500/success.html
PAYFAST_CANCEL_URL=http://localhost:5500/checkout.html
PAYFAST_NOTIFY_URL=http://localhost:5500/api/payment/notify

# ── Storage ──────────────────────────────────────
# Where QR code PNGs are saved (relative to backend/)
TICKETS_DIR=./tickets

# ── Security ─────────────────────────────────────
APP_SECRET=change_this_random_secret_in_production
