# Mirrors netlify.toml's [[headers]] rules (same reasoning as _redirects).
#
# "no-cache" means: the browser may keep a copy but must ask Netlify "has this
# changed?" before using it. If not, Netlify answers with a tiny 304 and no file
# is re-downloaded (cheap bandwidth). If it HAS changed after a deploy, visitors
# get the new file straight away (no stale CSS/JS). The old "no-store" rule made
# every visit download every file again.

/js/*
  Cache-Control: no-cache

/css/*
  Cache-Control: no-cache

/*.html
  Cache-Control: no-cache

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-Robots-Tag: index, follow

/dashboard.html
  X-Robots-Tag: noindex, nofollow

/success.html
  X-Robots-Tag: noindex, nofollow

/checkout.html
  X-Robots-Tag: noindex, nofollow

/admin/*
  X-Robots-Tag: noindex, nofollow

/images/*
  Cache-Control: public, max-age=31536000, immutable

/sitemap.xml
  Content-Type: application/xml
  Cache-Control: public, max-age=86400

/robots.txt
  Content-Type: text/plain
  Cache-Control: public, max-age=86400
