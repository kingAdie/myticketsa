# Environment variables for the Netlify Functions in netlify/functions/
# Locally: copy this file to .env and fill it in (npm run dev reads it).
# On Netlify: Site configuration -> Environment variables.
#
# TicketsSA does not take or process any payments. Owners and customers
# arrange payment directly. These variables are only for email and login.

# Resend (https://resend.com): sends every email the site sends.
# Used by: firebase-send-auth-email, submit-seller-application,
#          notify-booking, notify-decision, notify-signin
RESEND_API_KEY=your-resend-api-key

# Firebase Admin SDK service account (Firebase Console -> Project settings ->
# Service accounts -> Generate new private key). Paste the ENTIRE downloaded
# JSON file as a single line. Server-side only: never commit a real value.
# Used by: firebase-set-role, firebase-send-auth-email, notify-booking, notify-decision
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"tickets-sa",...}

# Cloudflare Turnstile SECRET key (dash.cloudflare.com -> Turnstile -> your site).
# Used by: verify-turnstile, which checks the login/sign-up captcha server-side.
# If this function is missing or this variable is unset, nobody can log in.
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Where new-listing, booking and sign-up notifications are sent (default shown)
SUPPORT_EMAIL=support@ticketssa.co.za
# Optional extra recipients for those notifications, comma separated
ADMIN_EXTRA_EMAILS=
