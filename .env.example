# Environment variables required by netlify/functions/*
# Set these in Netlify: Site configuration → Environment variables
# (this repo has no server — these are consumed only by the serverless functions below)

# TicketsSA doesn't process payments. Event organisers collect payment
# themselves (their own payment link or bank details, entered per-event).
# These functions only handle email delivery.

# Resend (https://resend.com) — sends all transactional email
# Used by: send-auth-email.js, notify-signin.js
RESEND_API_KEY=your-resend-api-key

# Supabase Auth "Send Email" hook secret
# Supabase Dashboard → Authentication → Hooks → Send Email Hook
# → point it at https://<your-site>/.netlify/functions/send-auth-email
# → copy the generated secret (format: v1,whsec_...) here.
# Without this configured, Supabase sends its own default auth emails instead
# of the branded TicketsSA templates, and this function will reject all
# requests (missing signature) if the hook is never wired up.
SEND_EMAIL_HOOK_SECRET=

# Supabase service role key (Settings → API → service_role)
# Not currently used by any function (kept for future server-side needs).
# Server-side only — never expose this to the frontend, never commit a real value here.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Paystack secret key (Settings → API Keys & Webhooks → Secret Key)
# Used by: paystack-initialize.js (starts a transaction), paystack-verify.js
# (the browser's redirect back — confirms payment before a ticket is created
# and emailed), paystack-webhook.js (the reliable backup path — fires from
# Paystack's servers even if the buyer's browser never redirects back).
# This is the ONLY payment flow TicketsSA processes itself — organiser-
# collected events (link/bank/free) are unaffected. Server-side only — never
# expose this to the frontend, never commit a real value here. Use sk_test_…
# while testing and switch to the sk_live_… key only once you're ready to
# take real payments.
#
# Also set the webhook URL in the Paystack dashboard (Settings → API Keys &
# Webhooks → Webhook URL) to:
#   https://<your-site>/.netlify/functions/paystack-webhook
PAYSTACK_SECRET_KEY=your-paystack-secret-key


