# Environment variables required by netlify/functions/*
# Set these in Netlify: Site configuration → Environment variables
# (this repo has no server — these are consumed only by the serverless functions below)

# Most events: organisers collect payment themselves (their own payment link
# or bank details, entered per-event) and these functions only handle email
# delivery. Events opted into Paystack are the exception — TicketsSA
# processes that payment itself (see PAYSTACK_SECRET_KEY below).

# Resend (https://resend.com) — sends all transactional email
# Used by: send-auth-email.js, notify-signin.js
RESEND_API_KEY=your-resend-api-key

# Supabase Auth "Send Email" hook secret
# Supabase Dashboard → Authentication → Hooks → Send Email Hook
# → point it at https://<your-site>/.netlify/functions/send-auth-email
# → copy the generated secret (format: v1,whsec_...) here.
# Without this configured, Supabase sends its own default auth emails instead
# of the branded TicketsSA templates, and this function will reject all
# requests (missing signature) if the hook is never wired up.
SEND_EMAIL_HOOK_SECRET=

# Supabase service role key (Settings → API → service_role)
# Not currently used by any function (kept for future server-side needs).
# Server-side only — never expose this to the frontend, never commit a real value here.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Paystack secret key (Settings → API Keys & Webhooks → Secret Key)
# Used by: paystack-initialize.js (starts a transaction), paystack-verify.js
# (the browser's redirect back — confirms payment before a ticket is created
# and emailed), paystack-webhook.js (the reliable backup path — fires from
# Paystack's servers even if the buyer's browser never redirects back).
# This is the ONLY payment flow TicketsSA processes itself — organiser-
# collected events (link/bank/free) are unaffected. Server-side only — never
# expose this to the frontend, never commit a real value here. Use sk_test_…
# while testing and switch to the sk_live_… key only once you're ready to
# take real payments.
#
# Also set the webhook URL in the Paystack dashboard (Settings → API Keys &
# Webhooks → Webhook URL) to:
#   https://<your-site>/.netlify/functions/paystack-webhook
PAYSTACK_SECRET_KEY=your-paystack-secret-key

# Firebase Admin SDK service account (Firebase Console → Project settings →
# Service accounts → Generate new private key). Paste the ENTIRE downloaded
# JSON file's contents here as a single line (most shells/hosts are fine with
# a JSON string containing literal \n in the private_key field — that's how
# the key comes out of the download already, don't reformat it).
# Used by: firebase-set-role.js (sets the admin/organiser custom claim —
# this is what actually authorizes a promoted user, not just a display
# field), firebase-send-auth-email.js (generates the real verify-email /
# password-reset links via the Admin SDK, then sends them through Resend
# instead of Firebase's own template emails).
# Server-side only — never expose this to the frontend, never commit a real
# value here. Runs from Netlify Functions, NOT Firebase Cloud Functions, so
# this works on Firebase's free Spark plan — no billing account needed.
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"tickets-sa",...}

# Cloudflare Turnstile secret key (dash.cloudflare.com → Turnstile → your
# site → Secret Key). Used by: verify-turnstile.js, which checks the token
# from the login/signup CAPTCHA widget server-side before Firebase Auth is
# ever called now that Supabase's built-in captchaToken passthrough is gone,
# this is what makes the CAPTCHA actually enforce something instead of being
# decorative. Server-side only — never expose this to the frontend.
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
